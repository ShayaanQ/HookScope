# Copy this file to .env for local Compose use. Do not commit .env.
HOOKSCOPE_DB_NAME=hookscope
HOOKSCOPE_DB_USER=hookscope
HOOKSCOPE_DB_PASSWORD=change-this-local-database-password

# M1-B requires a nonblank administrator token of at least 32 characters. Generate one locally;
# keep this value empty in the example and never commit a usable token.
HOOKSCOPE_ADMIN_TOKEN=

# Default is 1 MiB (1,048,576 bytes).
HOOKSCOPE_INGESTION_MAXIMUM_BODY_SIZE=1048576

# Optional comma-separated additional exact header names to redact before persistence.
HOOKSCOPE_ADDITIONAL_SENSITIVE_HEADERS=
