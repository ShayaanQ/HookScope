# Copy this file to .env for local Compose use. Do not commit .env.
HOOKSCOPE_DB_NAME=hookscope
HOOKSCOPE_DB_USER=hookscope
HOOKSCOPE_DB_PASSWORD=change-this-local-database-password

# M1-A does not enforce this value. M1-B requires a nonblank token of at least 32 characters.
HOOKSCOPE_ADMIN_TOKEN=

# Default is 1 MiB (1,048,576 bytes).
HOOKSCOPE_INGESTION_MAXIMUM_BODY_SIZE=1048576
